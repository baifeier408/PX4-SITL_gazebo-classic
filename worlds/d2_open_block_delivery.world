<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <!-- Fixed overview camera for D2 open-block delivery scene. -->
        <pose>7 -14 12 0 0.75 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>250</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
    </physics>

    <!-- Open-block obstacle layout:
         This is not a tunnel. Buildings are separated blocks that force a turn-around route. -->

    <model name="d2_building_main">
      <static>true</static>
      <pose>5 0.65 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.8 1.8 4.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.8 1.8 4.0</size></box>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="d2_building_lower">
      <static>true</static>
      <pose>7.8 -5.2 1.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.6 1.6 3.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.6 1.6 3.5</size></box>
          </geometry>
          <material>
            <ambient>0.38 0.38 0.38 1</ambient>
            <diffuse>0.48 0.48 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="d2_building_goal_side">
      <static>true</static>
      <pose>10.8 2.3 1.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.8 2.0 3.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.8 2.0 3.5</size></box>
          </geometry>
          <material>
            <ambient>0.38 0.38 0.38 1</ambient>
            <diffuse>0.48 0.48 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="d2_small_block">
      <static>true</static>
      <pose>3.0 3.0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.4 1.4 2.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.4 1.4 2.4</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="d2_pole_1">
      <static>true</static>
      <pose>8.7 0.15 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="d2_pole_2">
      <static>true</static>
      <pose>11.8 3.4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="d2_delivery_pad">
      <static>true</static>
      <pose>12.5 4.3 0.03 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.75</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.75</radius>
              <length>0.06</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.1 1</ambient>
            <diffuse>0.1 0.85 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Blue waypoint markers for visual debugging. -->
    <model name="d2_wp_start">
      <static>true</static>
      <pose>1 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="d2_wp_approach">
      <static>true</static>
      <pose>3.2 -1.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="d2_wp_turn">
      <static>true</static>
      <pose>7.2 -0.9 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="d2_wp_goal">
      <static>true</static>
      <pose>12.5 4.3 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
